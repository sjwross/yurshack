# Copy to .env on the server (outside web root preferred) or keep beside config.
# Never commit real secrets.

# Mail — PHPMailer (vendor usually at ~/public_html/vendor on projtoolbox)
MAIL_TO=support@yurshack.com
MAIL_FROM=noreply@yurshack.com
MAIL_FROM_NAME=Yur Shack
SMTP_HOST=mail.yurshack.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# PostgreSQL (PDO DSN)
# Example: pgsql:host=localhost;port=5432;dbname=yurshack
POSTGRES_DSN=pgsql:host=localhost;port=5432;dbname=yurshack
POSTGRES_USER=yurshack
POSTGRES_PASS=

# Support admin login (HTTP session)
ADMIN_USER=support
ADMIN_PASSWORD=

# Optional absolute path to Composer autoload if not at ../vendor/autoload.php
# COMPOSER_AUTOLOAD=/home/USER/public_html/vendor/autoload.php
